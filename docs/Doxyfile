# ou_sdk Doxygen 配置
# 用法：在仓库根目录运行 `doxygen docs/Doxyfile`，产物输出到 build/doxygen/html/。
# 覆盖范围：手写公共头 include/ + codegen 生成头 generated/ou/。

DOXYFILE_ENCODING      = UTF-8
PROJECT_NAME           = "ou_sdk"
PROJECT_BRIEF          = "水下机器人上位机侧 SDK（C++20）"
PROJECT_NUMBER         = 0.2.0
OUTPUT_LANGUAGE        = Chinese

# 输出目录（相对仓库根，因使用 -S 不便，这里按 Doxyfile 所在目录的相对路径）
OUTPUT_DIRECTORY       = ../build/doxygen

# 输入路径：相对 docs/ 目录
INPUT                  = ../include \
                         ../generated/ou

RECURSIVE              = YES
FILE_PATTERNS          = *.h *.hpp *.cpp *.md

# 提取范围
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO

# 文档内容
HIDE_UNDOC_MEMBERS     = NO
HIDE_UNDOC_CLASSES     = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# 输出格式
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO

# 优化
OPTIMIZE_OUTPUT_FOR_C  = NO
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = NO
